{
    "ci": {
        "collect": {
            "startServerCommand": "PORT=8000 npm start",
            "startServerReadyPattern": "server started",
            "url": [
                "http://localhost:8000/",
                "http://localhost:8000/history",
                "http://localhost:8000/shotgun"
            ],
            "numberOfRuns": 3,
            "settings": {
                "formFactor": "mobile"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".lighthouseci"
        }
    }
}
